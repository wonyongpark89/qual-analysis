    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Submit or advance the current analysis task.",
      "html": "<button class=\"ds-primary\">Submit Categories</button>",
      "css": ".ds-primary{font-family:var(--ui-font,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);background:var(--accent,#285b47);color:var(--surface,#fff);border:1px solid var(--accent,#285b47);border-radius:var(--radius,4px);min-height:38px;padding:9px 16px;font-size:12px;font-weight:600;line-height:1.4;cursor:pointer;transition:background-color 150ms,border-color 150ms,color 150ms}.ds-primary:hover{background:#1f4b39;border-color:#1f4b39}.ds-primary:focus-visible{outline:2px solid var(--accent,#285b47);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Quiet supporting action in a reading toolbar.",
      "html": "<button class=\"ds-secondary\">Print / Save as PDF</button>",
      "css": ".ds-secondary{font-family:var(--ui-font,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);background:var(--surface,#fff);color:var(--ink,#29362f);border:1px solid var(--border,#d7ddd6);border-radius:var(--radius,4px);min-height:36px;padding:8px 12px;font-size:12px;font-weight:550;line-height:1.4;cursor:pointer;transition:background-color 150ms,border-color 150ms,color 150ms}.ds-secondary:hover{background:var(--tint,#e8eee6);border-color:#a5b3a6}.ds-secondary:active{background:#dce6d9}.ds-secondary:focus-visible{outline:2px solid var(--accent,#285b47);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}"
    },
    {
      "name": "Coding Field",
      "kind": "input",
      "refersTo": "field-code",
      "description": "Give a selected passage a short code.",
      "html": "<label class=\"ds-label\" for=\"ds-code\">Code the selected extract</label><input class=\"ds-field\" id=\"ds-code\" placeholder=\"Give this extract a short label\">",
      "css": ".ds-label{font-family:var(--ui-font,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);display:block;margin-bottom:7px;font-size:12px;font-weight:600;color:var(--ink,#29362f)}.ds-field{font-family:var(--ui-font,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);width:100%;padding:12px 14px;border:1px solid #b6c2b0;border-radius:var(--radius,4px);background:#fbfcf9;color:var(--ink,#29362f);font-size:13px;caret-color:var(--accent,#285b47)}.ds-field::placeholder{color:var(--muted,#626d65);opacity:1}.ds-field:focus-visible{outline:2px solid var(--accent,#285b47);outline-offset:3px}@media(max-width:800px){.ds-field{font-size:16px;padding:11px 12px}}"
    },
